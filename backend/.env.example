# ==============================================================================
# Geofence-Based Multi-Workplace Attendance Platform Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development # Set to 'production' in deployed environments
MONGODB_URI=mongodb://localhost:27017/geofence_attendance

# Authentication & Session Security
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_for_production
JWT_EXPIRES_IN=7d

# Microservice Integrations
ML_SERVICE_URL=http://localhost:5001

# Workplace Shift & Geofence Defaults
DEFAULT_GEOFENCE_RADIUS=50
SHIFT_START_DEFAULT=09:00
SHIFT_END_DEFAULT=18:00

# ==============================================================================
# SMS OTP VERIFICATION PROVIDER CONFIGURATION
# ==============================================================================
# Choose one of:
# - 'twilio' : Official Twilio Verify API (Recommended for Global / Direct developer onboarding)
# - 'msg91'  : Official MSG91 SendOTP API (Recommended for Indian DLT-compliant low-cost delivery)
# - 'mock'   : Local development & automated testing ONLY (Forbidden in production)
SMS_PROVIDER=mock

# OTP Timing & Security Controls
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------------------
# OPTION A: Twilio Verify Configuration (https://console.twilio.com/)
# ------------------------------------------------------------------------------
# 1. Sign up for a Twilio Account.
# 2. Navigate to Console -> Verify -> Services -> Create Service.
# 3. Copy your Account SID, Auth Token, and Verify Service SID (starts with 'VA').
# 4. Set SMS_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# OPTION B: MSG91 Configuration (https://msg91.com/)
# ------------------------------------------------------------------------------
# 1. Register with MSG91 and complete Indian TRAI DLT Entity registration.
# 2. Go to OTP -> Flow / Templates -> Create an OTP Template.
# 3. Retrieve your AuthKey from MSG91 Dashboard -> Developer -> Authkey.
# 4. Set SMS_PROVIDER=msg91.
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_dlt_approved_template_id_here

# ==============================================================================
# REAL GMAIL DISPATCH CONFIGURATION (Google App Password)
# ==============================================================================
# Use official Google SMTP to send real verification emails to users' Gmail inboxes.
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Create an app named "Attendance Platform" and generate a 16-character password.
# 4. Fill in your Gmail and App Password:
GMAIL_USER=your_organization_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
