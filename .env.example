# Environment Configuration Example
# Geofence-Based Attendance Management System

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/geofence_attendance

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_for_geofence_attendance_2026
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Microservices
ML_SERVICE_URL=http://localhost:5001

# Geofence & Shift Schedule
DEFAULT_GEOFENCE_RADIUS=50
SHIFT_START_DEFAULT=09:00
SHIFT_END_DEFAULT=18:00
